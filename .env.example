# Server-side PHP runtime settings ONLY. Never use NEXT_PUBLIC_ for these.
# On Hostinger, place the real file at ../ilaw-auth.env, OUTSIDE public_html.
ILAW_ADMIN_USERNAME=
ILAW_ADMIN_PASSWORD_HASH=
SESSION_SECRET=
ILAW_SITE_ORIGIN=https://ilaw.lenybuilds.com
# Optional shorter session: 8 hours maximum and 1 hour idle by default.
ILAW_SESSION_SECONDS=28800
ILAW_IDLE_SECONDS=3600
# Remember Me: 7 days maximum by default; maximum permitted is 7 days.
ILAW_REMEMBER_SECONDS=604800
